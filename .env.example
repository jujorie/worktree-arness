# Read by scripts/video-server.sh. Flags override these; empty or missing = autodetect/default.
# macOS: name or index from `scripts/video-server.sh --list`. Linux: /dev/videoN.
VIDEO_DEVICE=
# macOS: audio device name or index. Linux: ALSA (arecord -l -> hw:N). "none" = no audio.
AUDIO_DEVICE=
VIDEO_SIZE=1280x720
VIDEO_FPS=30
RTSP_URL=rtsp://127.0.0.1:8554/live
